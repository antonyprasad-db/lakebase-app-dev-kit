# Contributor test configuration template for the consort.
#
# This file is committed and sourced by the kit's CONTRIBUTOR test
# drivers (scripts/run-all-live-tests.sh) to establish public-default
# values for every env-overridable knob the substrate exposes during
# live tests.
#
# Kit USERS (apps that consume @databricks-solutions/consort)
# don't use this file. See .env.kit.example instead.
#
# Local overrides live in `.env.local.test.config` (gitignored). The
# drivers source THIS file first, then `.env.local.test.config` if
# present, so local values win.
#
# Adding a new knob: set its public-default URL / value here as a real
# value (not a comment), document it in `scripts/lakebase/kit-config.ts`,
# and mention the variable in `.env.local.test.config` for local override
# guidance.

# ─── Package registries ───────────────────────────────────────────────
# Public mainline registries. Override in .env.local.test.config when
# your environment requires a proxy (corp network, air-gapped, etc.).
export LAKEBASE_KIT_REGISTRY_MAVEN_CENTRAL=https://repo1.maven.org/maven2
export LAKEBASE_KIT_REGISTRY_SPRING_INITIALIZR=https://start.spring.io
export NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
export PIP_INDEX_URL=https://pypi.org/simple
export UV_INDEX_URL=https://pypi.org/simple
export MVNW_REPOURL=https://repo.maven.apache.org/maven2

# ─── Lakebase convention branch TTLs (ms) ─────────────────────────────
# PSA convention defaults. Override per-tier in .env.local.test.config when
# your workspace's max-expiration policy is tighter.
# 30 days = 2592000000 ms
export LAKEBASE_KIT_FEATURE_BRANCH_TTL_MS=2592000000
# 14 days = 1209600000 ms
export LAKEBASE_KIT_TEST_BRANCH_TTL_MS=1209600000
export LAKEBASE_KIT_UAT_BRANCH_TTL_MS=1209600000
# 7 days = 604800000 ms
export LAKEBASE_KIT_PERF_BRANCH_TTL_MS=604800000

# ─── Lakebase live-test target (used by run-all-live-tests.sh) ─────────
# Optional. Set when reusing a workspace + project across runs instead
# of auto-provisioning a fresh one each invocation. Documented here for
# discoverability; set the actual value in .env.local.test.config.
#
# LAKEBASE_TEST_INSTANCE=
# LAKEBASE_TEST_BRANCH=
# LAKEBASE_TEST_PARENT=
# LAKEBASE_TEST_PROJECT_PATH=

# ─── GitHub owner for PR + gates suites ───────────────────────────────
# Unlocks gates-state-machine-e2e-live + lakebase-pr-cli-live.
# Set in .env.local.test.config to your sandbox GitHub user or org; both
# suites create + tear down real repos and PRs under this owner.
#
# LAKEBASE_TEST_GITHUB_OWNER=

# ─── Approver identity for the gates live suite ───────────────────────
# The approver email recorded at HITL gates in gates-state-machine-e2e-live.
# Optional; defaults to approver@example.com. Set to your own address only
# if your assertions need a specific approver.
#
# LAKEBASE_TEST_APPROVER_EMAIL=

# ─── Databricks workspace + Lakebase test target (the SINGLE home) ────
# This block is THE one place the live-test workspace/profile/instance is
# configured. tests/support/test-env.ts (resolveTestEnv) + the runner
# scripts read ONLY these env vars , there is NO hardcoded workspace/profile
# fallback anywhere in source (the ecparr literal appears only here-as-doc,
# in your gitignored .env.local.test.config, and in recorded corpus data).
# Set the concrete values in .env.local.test.config; leave them unset to
# skip the live suites cleanly. The public template ships NO private host.
#
# DATABRICKS_CONFIG_PROFILE , the CLI profile for the target workspace.
# test-env resolves the host from it via `databricks auth describe`. Primary
# knob; set it and LAKEBASE_TEST_HOST is optional.
# DATABRICKS_CONFIG_PROFILE=your-workspace-profile
#
# LAKEBASE_TEST_HOST , explicit host override (skips profile resolution; for
# CI / no-profile environments).
# LAKEBASE_TEST_HOST=https://your-workspace.cloud.databricks.com
#
# LAKEBASE_TEST_INSTANCE , reuse an existing Lakebase project instead of
# provisioning a fresh one (read-only + reuse suites). Optional.
# LAKEBASE_TEST_INSTANCE=
# LAKEBASE_TEST_BRANCH=
# LAKEBASE_TEST_PARENT=
#
# LAKEBASE_TEST_E2E=1 unlocks the destructive create/delete suites (they
# create + tear down a real Lakebase project + repo). Off by default.
# LAKEBASE_TEST_E2E=1
