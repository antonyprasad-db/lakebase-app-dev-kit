{
  "id": "stockflow-demo-po-seed",
  "role": "product-owner",
  "match": { "kind": "invoke-role", "role": "product-owner", "mode": "author-requests" },
  "inputs": [],
  "outputs": [
    { "id": "product-overview", "filename": "product-overview.md", "validator": "nonEmptyFile", "description": "The PO's product overview , what StockFlow is + who uses it." },
    { "id": "nfrs", "filename": "nfrs.md", "validator": "nonEmptyFile", "description": "The PO's non-functional requirements brief (durability, etc.)." },
    { "id": "design-guideline", "filename": "design-brief.md", "validator": "nonEmptyFile", "description": "The PO's design guideline / brief the UX + build must honor." },
    { "id": "agent-log", "filename": "agent-log.jsonl", "validator": "productOwnerLoggedAuthoring", "description": "The PO mock logs what it authored (shared agent-log; agent-log-event.schema.json)." }
  ],
  "routing": {
    "produced": { "next": { "kind": "invoke-role", "role": "spec-author", "mode": "breakdown" } }
  },
  "agentOptions": {
    "session": "fresh",
    "resumeKeyFrom": "none"
  },
  "agent": {
    "kind": "replay",
    "config": {
      "role": "product-owner",
      "seeds": [
        { "outputId": "product-overview", "from": "product-overview.md", "to": "product-overview.md" },
        { "outputId": "nfrs", "from": "nfrs.md", "to": "nfrs.md" },
        { "outputId": "design-guideline", "from": "design-brief.md", "to": "design-brief.md" }
      ]
    }
  }
}
