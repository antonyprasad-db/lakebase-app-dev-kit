{
  "typography": {
    "font_family": "'DM Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "font_mono": "'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "scale": {
      "text-xs": "10px",
      "text-sm": "13px",
      "text-base": "15px",
      "text-md": "16px",
      "text-lg": "20px",
      "text-xl": "24px",
      "text-xxl": "29px"
    },
    "line_heights": {
      "body": "1.5",
      "heading": "1.25"
    },
    "font_weights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "colors": {
    "brand": {
      "brand-red": "#FF3621",
      "brand-red-hover": "#EB1600"
    },
    "semantic": {
      "success": "#2E844A",
      "warning": "#FFAB00",
      "info": "#0176D3",
      "error": "#FF3621"
    },
    "surface": {
      "page": "#F9F7F4",
      "card": "#FFFFFF"
    },
    "text": {
      "primary": "#1B3139"
    }
  },
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-6": "24px",
    "space-8": "32px",
    "space-12": "48px",
    "space-16": "64px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px",
    "button": "0px"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(27,49,57,0.08)",
    "md": "0 2px 6px rgba(27,49,57,0.12)",
    "lg": "0 8px 24px rgba(27,49,57,0.16)"
  },
  "breakpoints": {
    "tablet": "768px",
    "desktop": "1024px"
  },
  "components": {
    "navbar": { "class": "navbar", "notes": "navy-900 bg, 64px, 2px brand-red bottom border; app icon + title left, nav links right" },
    "page": { "class": "page", "notes": "warm-oat bg, 960px centered content; page__header + page__title (icon + name)" },
    "card": { "class": "card", "notes": "white surface, --radius-lg, --shadow-sm, --space-5 padding" },
    "button": { "class": "btn", "variants": "btn--primary (brand-red, sharp 0 corner), btn--secondary, btn--ghost" },
    "form_input": { "class": "field", "notes": "persistent label (not placeholder-only), --radius-sm, focus ring --color-info; validation error inline near the field" },
    "table": { "class": "stock-table", "notes": "cool header row uppercase; numeric qty cells right-aligned, --font-mono, tabular-nums" },
    "status_badge": { "class": "badge", "variants": "badge--in-stock, badge--low, badge--out, badge--on-order, badge--quarantined", "notes": "pill, --text-xs uppercase; state carried by text + shape, not color alone" },
    "empty_state": { "class": "empty-state", "notes": "icon + heading + teaching copy + CTA (e.g. 'No stock at this location, receive an inbound shipment'), never a blank region" },
    "toast": { "class": "toast", "notes": "fixed top-right; success auto-dismiss 3s, error persists; no layout shift" },
    "app_icon": { "asset": "client/src/assets/warehouse.png", "favicon": "client/public/favicon.svg", "notes": "StockFlow warehouse app icon in the navbar/title + a favicon for the browser tab" }
  }
}
