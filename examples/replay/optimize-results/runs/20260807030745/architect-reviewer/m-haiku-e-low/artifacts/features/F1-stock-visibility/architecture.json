{
  "feature_id": "F1-stock-visibility",
  "service_backed": true,
  "layers": [
    {
      "name": "Stock Routes (Boundary)",
      "role": "boundary",
      "module": "app/routes/",
      "renders_via": "react",
      "may_import": ["service"]
    },
    {
      "name": "Stock Service",
      "role": "service",
      "module": "app/services/",
      "may_import": ["repository"]
    },
    {
      "name": "Stock Repository",
      "role": "repository",
      "module": "app/repositories/",
      "may_import": ["models"]
    },
    {
      "name": "Stock Models",
      "role": "models",
      "module": "app/models/",
      "may_import": []
    }
  ],
  "persistence_invariants": [
    {
      "id": "PI1-stock-sku-location-unique",
      "type": "unique",
      "table": "stock_records",
      "brief": "Each (sku, location) pair is uniquely addressable; no two records share that combination (R3)."
    },
    {
      "id": "PI2-stock-quantity-non-negative",
      "type": "check",
      "table": "stock_records",
      "brief": "Stock quantity is never negative; the constraint enforces quantity >= 0 (R2)."
    },
    {
      "id": "PI3-migration-preserves-stock-data",
      "type": "migration_reversible",
      "table": "stock_records",
      "brief": "Existing stock data survives every schema migration with no loss; migrations are additive (R1)."
    }
  ],
  "nfrs": [
    {
      "id": "NFR-R1-durable-persistence",
      "brief": "Stock records durably saved with unmodifiable timestamp and actor for audit trail.",
      "applies_to": "F1-stock-visibility",
      "hil_status": "proposed",
      "brief_ref": "R1"
    },
    {
      "id": "NFR-R2-no-overcommit",
      "brief": "Stock levels never go below zero and never overcommit beyond available quantity; picks rejected at write time.",
      "applies_to": "F1-stock-visibility",
      "hil_status": "proposed",
      "brief_ref": "R2"
    },
    {
      "id": "NFR-R3-sku-location-unique",
      "brief": "Each SKU at each location is uniquely addressable by (sku, location); collisions resolved at write time.",
      "applies_to": "F1-stock-visibility",
      "hil_status": "proposed",
      "brief_ref": "R3"
    },
    {
      "id": "NFR-R4-real-branch-tests",
      "brief": "Integration tests run against paired Lakebase branch, not mocks or in-memory substitutes.",
      "applies_to": "F1-stock-visibility",
      "hil_status": "proposed",
      "brief_ref": "R4"
    },
    {
      "id": "NFR-R5-react-spa",
      "brief": "UI is a React + TypeScript SPA under client/; backend returns JSON API; client-side navigation with optimistic updates.",
      "applies_to": "F1-stock-visibility",
      "hil_status": "proposed",
      "brief_ref": "R5"
    }
  ]
}
