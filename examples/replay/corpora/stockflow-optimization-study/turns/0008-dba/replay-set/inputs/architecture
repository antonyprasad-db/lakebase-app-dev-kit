{
  "feature_id": "F1-stock-visibility",
  "service_backed": true,
  "layers": [
    {
      "name": "stock-api",
      "role": "boundary",
      "module": "app/routes/",
      "may_import": ["service"]
    },
    {
      "name": "stock-service",
      "role": "service",
      "module": "app/services/",
      "may_import": ["repository", "models"]
    },
    {
      "name": "stock-repository",
      "role": "repository",
      "module": "app/repositories/",
      "may_import": ["models"]
    },
    {
      "name": "domain-models",
      "role": "models",
      "module": "app/models/",
      "may_import": []
    }
  ],
  "persistence_invariants": [
    {
      "id": "PI1-unique-sku-location",
      "type": "unique",
      "table": "stock_records",
      "brief": "Unique composite key on (sku, location) so no two rows share the same SKU-at-location pair; a repeat filing collides and updates in place (R3)."
    },
    {
      "id": "PI2-required-columns-not-null",
      "type": "not_null",
      "table": "stock_records",
      "brief": "sku, location, and quantity are NOT NULL so a filed record always carries its identity and level."
    },
    {
      "id": "PI3-quantity-non-negative",
      "type": "check",
      "table": "stock_records",
      "brief": "CHECK quantity >= 0 so a stored stock level can never go below zero (R2)."
    },
    {
      "id": "PI4-migration-reversible",
      "type": "migration_reversible",
      "table": "stock_records",
      "brief": "The Alembic migration creating stock_records is additive and reversible, preserving pre-existing inventory rows across the upgrade (R1)."
    }
  ],
  "nfrs": [
    {
      "id": "NFR-F1-1-migration-preserves-data",
      "category": "reliability",
      "applies_to": "F1-stock-visibility",
      "brief_ref": "R1",
      "brief": "Existing stock rows survive every additive schema migration with no loss; migrations are reversible. Defended by a real-branch migration test applying upgrade over seeded data and asserting row survival.",
      "hil_status": "proposed"
    },
    {
      "id": "NFR-F1-2-no-negative-stock",
      "category": "correctness",
      "applies_to": "F1-stock-visibility",
      "brief_ref": "R2",
      "brief": "Stock levels never persist below zero; a filing that would drive quantity negative is rejected at write time (CHECK constraint PI3 plus service-layer guard).",
      "hil_status": "proposed"
    },
    {
      "id": "NFR-F1-3-unique-sku-location",
      "category": "correctness",
      "applies_to": "S1-file-stock-record",
      "brief_ref": "R3",
      "brief": "Every (sku, location) pair is uniquely addressable; collisions resolve to an in-place update at write time via the DB unique constraint PI1 (never two duplicates, never an error page).",
      "hil_status": "proposed"
    },
    {
      "id": "NFR-F1-4-real-branch-integration-tests",
      "category": "testability",
      "applies_to": "F1-stock-visibility",
      "brief_ref": "R4",
      "brief": "Integration tests run against the paired Lakebase branch (databricks_postgres via DATABASE_URL), never a mock or in-memory substitute; CI refuses a PR whose integration tests do not run against a real branch.",
      "hil_status": "proposed"
    },
    {
      "id": "NFR-F1-5-spa-json-api",
      "category": "architecture",
      "applies_to": "F1-stock-visibility",
      "brief_ref": "R5",
      "brief": "The boundary is a JSON API returning data (not server-rendered HTML); the UI is a React + TypeScript SPA under client/ that navigates client-side and updates rows in place. The API is covered by the R4 branch integration tests.",
      "hil_status": "proposed"
    },
    {
      "id": "NFR-F1-6-named-validation-messages",
      "category": "usability",
      "applies_to": "S1-file-stock-record",
      "brief": "Validation failures on filing return clear, specific messages naming the offending field (not a bare 'bad request'). Owned at the boundary. (PO preference.)",
      "hil_status": "proposed"
    }
  ]
}
