  "persistence_invariants": [
    {
      "id": "PI1-batch-serial-nullable",
      "type": "not_null",
      "table": "stock",
      "brief": "batch_number and serial_number are added as NULLABLE columns; nonconforming codes leave them NULL rather than violating a constraint (AC3). The NOT NULL invariant is that this constraint is DEFERRED for these two columns while sku/location/quantity remain NOT NULL."
    },
    {
      "id": "PI2-sku-location-unique-preserved",
      "type": "unique",
      "table": "stock",
      "brief": "The composite UNIQUE(sku, location) from F1 survives the add-and-backfill migration unchanged; location stays the canonical addressing column and is not re-derived from the code leading segment (R3)."
    },
    {
      "id": "PI3-add-backfill-atomic",
      "type": "transactional",
      "table": "stock",
      "brief": "The column-add plus backfill runs as a single atomic migration transaction: either every row is backfilled or none is, so a failed run cannot half-populate or drop rows (AC4, R1)."
    },
    {
      "id": "PI4-every-row-preserved",
      "type": "check",
      "table": "stock",
      "brief": "Row count and each row's canonical sku/location/quantity are unchanged across the migration; the backfill is an in-place UPDATE that never DELETEs or mutates canonical fields, verified by a before/after diff on the paired branch (AC4, R1)."
    },
    {
      "id": "PI5-migration-reversible",
      "type": "migration_reversible",
      "table": "stock",
      "brief": "The Alembic upgrade adding batch_number/serial_number has a working downgrade; end-state reversibility for the split is provided by reconstructing inventory_code from canonical location plus batch/serial, not by leaving the column in place (R1)."
    }
  ],
  "nfrs": [
    {
      "id": "NFR-F6-data-durability",
      "category": "reliability",
      "applies_to": "F6-split-tracking-code",
      "brief_ref": "R1",
      "brief": "Every sprint-1 stock row survives the schema refactor with no loss or corruption. The add-and-backfill migration is additive and atomic (PI3, PI4); nonconforming codes are left NULL rather than guessed or dropped (AC3), and an integrity probe surfaces the nonconforming count for review before acceptance (AC5). Reversibility is provided by a paired downgrade (PI5).",
      "hil_status": "accepted"
    },
    {
      "id": "NFR-F6-unique-identity-preserved",
      "category": "correctness",
      "applies_to": "F6-split-tracking-code",
      "brief_ref": "R3",
      "brief": "Splitting the combined code into batch_number and serial_number gives each stock position a single unambiguous identity with separately addressable fields (R3). The canonical (sku, location) uniqueness from F1 is preserved unchanged (PI2); location is NOT re-derived from the code's leading segment.",
      "hil_status": "accepted"
    },
    {
      "id": "NFR-F6-real-branch-integration-tests",
      "category": "testability",
      "applies_to": "F6-split-tracking-code",
      "brief_ref": "R4",
      "brief": "Correctness is proven by a parent-aware schema diff plus the integrity-probe count run against the paired Lakebase branch via DATABASE_URL — real integration tests (pytest-bdd, Alembic applied to the branch first), never a mock or in-memory substitute. CI refuses to merge if integration tests do not run against a real branch.",
      "hil_status": "accepted"
    },
    {
      "id": "NFR-F6-spa-json-boundary",
      "category": "architecture",
      "applies_to": "S3-expose-batch-serial-in-stock-ui",
      "brief_ref": "R5",
      "brief": "Where the combined code was shown before, batch and serial are exposed as distinct fields in the React + TypeScript SPA under client/, fed by the JSON API boundary (renders_via: react, no server-rendered HTML). Applies to the UI story S3; S1 (this story) is a schema/migration change with no boundary surface.",
      "hil_status": "accepted"
    },
    {
      "id": "NFR-F6-clean-render-optional-detail",
      "category": "usability",
      "applies_to": "S3-expose-batch-serial-in-stock-ui",
      "brief": "A stock row whose batch_number/serial_number are NULL (nonconforming legacy code) still renders cleanly: batch and serial default to an explicit 'not tracked' rather than a null crash or a blank region (nfrs.md clean-render preference). Owned in the React SPA view; the boundary returns null fields as JSON.",
      "hil_status": "accepted"
    },
    {
      "id": "NFR-F6-no-overcommit-na",
      "category": "correctness",
      "applies_to": "F6-split-tracking-code",
      "brief_ref": "R2",
      "brief": "N/A - this feature is a schema refactor of the tracking-code columns and does not touch quantity write paths, picks, or allocation. The non-negative/no-overcommit floor from F1 (PI2 on quantity) is unaffected and carried unchanged.",
      "hil_status": "accepted"
    }
  ]
}
