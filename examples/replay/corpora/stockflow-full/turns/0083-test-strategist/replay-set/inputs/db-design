{
  "feature_id": "F6-split-tracking-code",
  "tables": [
    {
      "name": "stock",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()",
          "description": "Surrogate primary key (unchanged from F1)."
        },
        {
          "name": "sku",
          "type": "text",
          "nullable": false,
          "description": "Canonical SKU; part of UNIQUE(sku, location). NOT NULL preserved unchanged from F1 (PI2-sku-location-unique-preserved, PI4-every-row-preserved)."
        },
        {
          "name": "location",
          "type": "text",
          "nullable": false,
          "description": "Canonical physical location; part of UNIQUE(sku, location). Stays authoritative and is NOT re-derived from the inventory_code leading segment (PI2-sku-location-unique-preserved, R3)."
        },
        {
          "name": "quantity",
          "type": "integer",
          "nullable": false,
          "default": "0",
          "description": "On-shelf quantity; NOT NULL and CHECK(quantity >= 0) carried unchanged from F1 (PI4-every-row-preserved)."
        },
        {
          "name": "inventory_code",
          "type": "text",
          "nullable": true,
          "description": "Original combined location-batch-serial tracking code, retained unchanged post-split so the migration is reversible by reconstruction (PI5-migration-reversible, AC1)."
        },
        {
          "name": "batch_number",
          "type": "text",
          "nullable": true,
          "description": "Second hyphen-delimited segment of inventory_code, backfilled by delimiter parse (AC2). NULLABLE: nonconforming codes leave this NULL rather than violating a constraint (PI1-batch-serial-nullable, AC3)."
        },
        {
          "name": "serial_number",
          "type": "text",
          "nullable": true,
          "description": "Third hyphen-delimited segment of inventory_code, backfilled by delimiter parse (AC2). NULLABLE: nonconforming codes leave this NULL (PI1-batch-serial-nullable, AC3)."
        }
      ],
      "primary_key": ["id"],
      "unique_constraints": [["sku", "location"]],
      "checks": [
        {
          "name": "ck_stock_quantity_nonnegative",
          "expression": "quantity >= 0"
        }
      ],
      "indexes": [
        {
          "name": "uq_stock_sku_location",
          "columns": ["sku", "location"],
          "unique": true
        }
      ]
    }
  ],
  "schema_changes": [
    {
      "story_id": "S1-add-and-backfill-columns",
      "kind": "add_column",
      "table": "stock",
      "detail": "Add two NULLABLE columns: batch_number text NULL, serial_number text NULL. No default, no NOT NULL, no new constraint (PI1-batch-serial-nullable, AC1). sku/location/quantity/inventory_code and UNIQUE(sku, location) are left untouched (PI2, AC1).",
      "migration_note": "PI3/PI4: run the ALTER TABLE ADD COLUMN plus the AC2/AC3 backfill UPDATE inside ONE Alembic upgrade transaction so a failed run cannot half-populate or drop rows. The backfill is an in-place UPDATE deriving batch_number = split_part(inventory_code,'-',2) and serial_number = split_part(inventory_code,'-',3) by hyphen delimiter (not fixed width), writing NULL where a segment is absent/empty (X-1, bare 'c'); it never DELETEs and never touches sku/location/quantity. PI5: downgrade is op.drop_column('serial_number') then op.drop_column('batch_number') — a clean reverse; end-state identity is reconstructible from inventory_code + canonical location, so no data is lost by dropping the split columns. AC5: an integrity probe (read-only) reports COUNT(*) WHERE batch_number IS NULL AND serial_number IS NULL for review before acceptance; it mutates nothing."
    }
  ],
  "realizes_invariants": [
    "PI1-batch-serial-nullable",
    "PI2-sku-location-unique-preserved",
    "PI3-add-backfill-atomic",
    "PI4-every-row-preserved",
    "PI5-migration-reversible"
  ]
}
