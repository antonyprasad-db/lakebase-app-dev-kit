{
  "id": "ux-designer-chain-seed",
  "role": "product-owner",
  "match": { "kind": "invoke-role", "role": "product-owner", "mode": "author-requests" },
  "inputs": [],
  "outputs": [
    { "id": "design-brief", "filename": "design-brief.md", "validator": "nonEmptyFile", "description": "The HIL design brief the UX Designer translates into the design system (the real-drive input)." },
    { "id": "product-overview", "filename": "product-overview.md", "validator": "nonEmptyFile", "description": "The product overview the UX Designer reads alongside the brief (the real-drive input)." },
    { "id": "agent-log", "filename": "agent-log.jsonl", "validator": "productOwnerLoggedAuthoring", "description": "The replay seed's authoring log." }
  ],
  "routing": {
    "produced": { "next": { "kind": "invoke-role", "role": "ux-designer" } }
  },
  "agentOptions": { "session": "fresh", "resumeKeyFrom": "none" },
  "agent": {
    "kind": "replay",
    "config": {
      "role": "product-owner",
      "seeds": [
        { "outputId": "design-brief", "from": "design-brief.md", "to": "design-brief.md" },
        { "outputId": "product-overview", "from": "product-overview.md", "to": "product-overview.md" }
      ]
    }
  }
}
