{
  "id": "navigator-red-chain-live",
  "role": "navigator",
  "match": { "kind": "invoke-role", "role": "navigator", "story": "S3-stock-shows-split-fields" },
  "inputs": [
    { "id": "test-list", "source": "feature:features/F6-split-tracking-code/test-list.json", "description": "The test-list spec , every item must be covered + faithfully asserted." },
    { "id": "ac", "source": "feature:features/F6-split-tracking-code/stories/S3-stock-shows-split-fields/acs/AC1-split-fields-shown.json", "description": "The story AC the tests encode." }
  ],
  "outputs": [
    { "id": "tests", "filename": "tests", "validator": "navigatorTestsAuthored", "description": "The RED test tree the Navigator authored (non-empty tests/ with the story's tests)." },
    { "id": "agent-log", "filename": "agent-log.jsonl", "validator": "navigatorLoggedAuthoring", "description": "The Navigator's authoring log." }
  ],
  "routing": {
    "produced": { "next": { "kind": "design-complete" } }
  },
  "agentOptions": { "model": "sonnet", "effort": "default", "session": "fresh", "resumeKeyFrom": "role" },
  "agent": {
    "kind": "claude",
    "config": {
      "role": "navigator",
      "model": "sonnet",
      "session": "fresh",
      "allowedTools": ["Write", "Read"],
      "disallowedTools": ["Bash", "Glob", "Grep", "WebFetch", "WebSearch", "Task"]
    }
  }
}
