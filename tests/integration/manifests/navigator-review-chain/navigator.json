{
  "id": "navigator-review-chain-live",
  "role": "navigator",
  "match": { "kind": "invoke-role", "role": "navigator", "story": "S1-split-columns-migration", "buildMode": "review", "ac": "AC1-batch-serial-columns-added" },
  "inputs": [
    { "id": "architecture", "source": "feature:.consort/features/F6-split-tracking-code/architecture.json", "description": "The architect's NFR contract the Navigator reviews the code against." },
    { "id": "ac", "source": "feature:.consort/features/F6-split-tracking-code/stories/S1-split-columns-migration/acs/AC1-batch-serial-columns-added.json", "description": "The story AC whose design intent guides the review." }
  ],
  "preconditions": [
    { "id": "code-review-context", "kind": "context-pack", "description": "The architecture + conventions context for NFR + naming review." }
  ],
  "outputs": [
    { "id": "review-verdict", "filename": ".consort/cycles/F6-split-tracking-code/S1-split-columns-migration/AC1-batch-serial-columns-added/review-verdict.json", "validator": "nonEmptyFile", "description": "The Navigator's review verdict: {refactor: bool, notes: \"<NFR analysis>\"}" },
    { "id": "agent-log", "filename": "agent-log.jsonl", "validator": "navigatorLoggedAuthoring", "description": "The Navigator's authoring log." }
  ],
  "routing": {
    "produced": { "next": { "kind": "design-complete" } }
  },
  "agentOptions": { "model": "sonnet", "effort": "default", "session": "fresh", "resumeKeyFrom": "role" },
  "agent": {
    "kind": "claude",
    "config": {
      "role": "navigator",
      "model": "sonnet",
      "session": "fresh",
      "allowedTools": ["Write", "Read", "Grep", "Glob"],
      "disallowedTools": ["Bash", "WebFetch", "WebSearch", "Task"]
    }
  }
}
