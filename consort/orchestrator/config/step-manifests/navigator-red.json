{
  "id": "navigator-red",
  "role": "navigator",
  "match": { "kind": "invoke-role", "role": "navigator", "buildMode": null },
  "inputs": [
    { "id": "test-list", "source": "story:test-list.json", "description": "The story's ordered test list , the Navigator authors ONE batch RED covering it." },
    { "id": "acs", "source": "story:acs", "description": "The story's acceptance criteria the failing tests encode." }
  ],
  "outputs": [],
  "routing": {
    "produced": { "next": "state-derived" }
  },
  "agentOptions": {
    "model": "sonnet",
    "effort": "default",
    "session": "resume",
    "resumeKeyFrom": "story"
  },
  "postTurn": [
    { "bin": "@build-cycle", "args": [], "when": "after" }
  ]
}
